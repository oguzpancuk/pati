{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(npm install)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run migrate)",
      "Bash(npx tsc:*)",
      "Bash(npx jest:*)",
      "Bash(npx prettier:*)",
      "Bash(npx react-native bundle:*)",
      "Bash(pod install)",
      "Bash(xcrun simctl list:*)",
      "Bash(curl -s http://localhost:3000/*)",
      "Read(**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.claude/last-reviewed)",
      "Write(**/.claude/last-reviewed)",
      "Bash(git update-ref:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-changed.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/review-gate.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-gate.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "code-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/review-mark.sh"
          }
        ]
      }
    ]
  }
}
