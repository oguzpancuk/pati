<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>pati</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Not $(PRODUCT_NAME): the target is PatiMobile, and iOS shows THIS
	     name in system dialogs such as the "wants to use accounts.google.com
	     to sign in" consent, where "pati" is what the user should read. -->
	<key>CFBundleName</key>
	<string>pati</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.oguzpancuk.pati</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pati</string>
				<!-- Google sign-in returns to the app through the reversed iOS
				     client id. Must equal IOS_GOOGLE_CLIENT_ID in
				     src/googleClientId.ts (a jest test enforces the pairing). -->
				<string>com.googleusercontent.apps.223239218396-o34fhrm0v2f23ev4o18g9pc5v6517fvn</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Export compliance, answered once here instead of on every upload:
	     the app's only cryptography is HTTPS, which is exempt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Mama/su bıraktığınızı doğrulamak, bir hayvanı kaydetmek ve bir hayvana bakım vermek için o an bir fotoğraf çekmeniz gerekiyor.</string>
	<!-- The WRITE half: the app saves the photo it just took when "galeriye
	     kaydet" is on. Without it iOS terminates the app the first time
	     UIImageWriteToSavedPhotosAlbum runs. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Uygulamada çektiğiniz fotoğrafların telefonunuzun galerisine de kaydedilmesi için izin gerekiyor.</string>
	<!-- The READ half. An earlier comment here claimed the app never reads
	     the library; that was simply wrong — the avatar picker calls
	     `launchImageLibrary` (screens/UserProfileScreen.tsx), and so does the
	     simulator stand-in for the camera. Apple's processing refused the
	     first upload over exactly this (ITMS-90683): the string is required
	     whenever the binary REFERENCES the API, and react-native-image-picker
	     references it whether or not a given screen calls it. Animal and care
	     photos still come from the camera only. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Profil fotoğrafınızı galerinizden seçebilmeniz için izin gerekiyor. Yalnızca seçtiğiniz fotoğraf uygulamaya aktarılır.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Yakınınızdaki bakım noktalarını ve hayvanları gösterebilmek, ve mama/su bıraktığınız konumu kaydedebilmek için konumunuza ihtiyacımız var.</string>
	<key>UIAppFonts</key>
	<array>
		<string>Nunito-SemiBold.ttf</string>
		<string>Nunito-Bold.ttf</string>
		<string>Nunito-Regular.ttf</string>
		<string>Nunito-ExtraBold.ttf</string>
		<string>Quicksand-Bold.ttf</string>
		<string>Quicksand-Regular.ttf</string>
		<string>Quicksand-Medium.ttf</string>
		<string>Quicksand-SemiBold.ttf</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Portrait only. The template also listed the two landscape
	     orientations, but no screen was ever laid out or verified sideways
	     (the map, the tab bar's measured geometry), and a store build should
	     not ship an orientation nobody looked at. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
