{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "feature_list",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "category", "description", "steps", "passes"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^F-[0-9]{3}$" },
      "category": { "type": "string", "enum": ["functional", "ui", "data", "auth", "ops"] },
      "description": { "type": "string", "minLength": 10 },
      "steps": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" },
        "description": "Human-verifiable steps a user would take to confirm the feature works end-to-end"
      },
      "passes": { "type": "boolean" }
    }
  }
}
