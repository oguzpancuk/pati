#!/usr/bin/env bash
# Boots the app for a work session in one command, so no session wastes
# context rediscovering setup. The initializer session (or /new-product,
# optionally, when the stack is already known) fills this in; copy to
# contracts/init.sh and keep it working.
set -euo pipefail
cd "$(dirname "$0")/.."
# [STACK: e.g.
#   npm ci
#   # Background servers must leave the caller's process group: an agent's
#   # shell tool waits on (and kills) the whole group, so a plain `… &`
#   # hangs the tool or dies with it. perl ships on macOS and CI images.
#   (perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' -- \
#      nohup npm run dev >/tmp/app.log 2>&1 </dev/null &)
#   sleep 3
#   curl -sf http://localhost:3000/health   # smoke check — fail loudly
# ]
echo "init.sh not configured yet" >&2
exit 1
