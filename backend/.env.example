PORT=3000
DATABASE_URL=postgresql://stray:stray@localhost:5433/stray
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Apple / Google sign-in (S7). Public identifiers, not secrets; leave empty to
# hide the buttons. Steps: docs/DEPLOYMENT.md -> "Apple / Google sign-in".
APPLE_CLIENT_IDS=
APPLE_SERVICE_ID=
APPLE_WEB_REDIRECT_URI=
GOOGLE_CLIENT_IDS=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# Photo checks and photo matching through Gemini (ADR-0005). Without the
# key both are off: photos are accepted unchecked and matching is
# field-only, as before. Key: Google AI Studio. AI_MODEL defaults to
# gemini-3.5-flash (on the paid tier — docs/DEPLOYMENT.md); another model must accept
# generationConfig.thinkingConfig, or every care check fails open.
GEMINI_API_KEY=
AI_MODEL=
